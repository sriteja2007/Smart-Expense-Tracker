# ==============================================================================
# LumaSpend (Smart Expense Tracker) - Environment Configuration Template
# Copy this file to server/.env and client/.env respectively.
# NEVER commit .env files containing real keys or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Server-Only, Confidential)
# Stored in: server/.env
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/lumaspend_dev
JWT_SECRET=lumaspend_development_jwt_secret_min_32_characters_long_12345
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=

# Optional: Email Delivery (e.g., Resend)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=noreply@lumaspend.local

# Optional: Web Push Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lumaspend.local

# ------------------------------------------------------------------------------
# FRONTEND PUBLIC ENVIRONMENT VARIABLES (Client-Exposed)
# Stored in: client/.env
# NOTE: Only variables prefixed with VITE_ are exposed to the browser client bundle.
# NEVER store secrets, database credentials, or private API keys here!
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=
VITE_DEFAULT_CURRENCY=INR
